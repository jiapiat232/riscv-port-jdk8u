  alloc_class chunk0(
    R0, R0_H, R1, R1_H, R2, R2_H, R3, R3_H, R4, R4_H, R5, R5_H, R6, R6_H, R7, R7_H,
    R8, R8_H, R9, R9_H, R10, R10_H, R11, R11_H, R12, R12_H, R13, R13_H, R14, R14_H, R15, R15_H,
