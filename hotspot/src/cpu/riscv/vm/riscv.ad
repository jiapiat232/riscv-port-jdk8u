frame %{
  stack_direction(TOWARDS_LOW);
  inline_cache_reg(R31);
  interpreter_method_oop_reg(R12);
  sync_stack_slots(2);
  frame_pointer(R8);
  interpreter_frame_pointer(R8);
  c_frame_pointer(R2);
  stack_alignment(StackAlignmentInBytes);
  in_preserve_stack_slots(4);
  varargs_C_out_slots_killed(0);
  return_addr(STACK - 2);

  calling_convention %{
    SharedRuntime::java_calling_convention(sig_bt, regs, length, false);
  %}

  c_calling_convention %{
    (void) SharedRuntime::c_calling_convention(sig_bt, regs, NULL, length);
  %}

  return_value %{
    assert(ideal_reg >= Op_RegI && ideal_reg <= Op_RegL, "only return normal values");
    static const int lo[Op_RegL + 1] = {
      0, 0,
      R10_num,
      R10_num,
      R10_num,
      F10_num,
      F10_num,
      R10_num
    };
    static const int hi[Op_RegL + 1] = {
      0, 0,
      OptoReg::Bad,
      OptoReg::Bad,
      R10_H_num,
      OptoReg::Bad,
      F10_H_num,
      R10_H_num
    };
    return OptoRegPair(hi[ideal_reg], lo[ideal_reg]);
  %}

  c_return_value %{
    assert(ideal_reg >= Op_RegI && ideal_reg <= Op_RegL, "only return normal values");
    static const int lo[Op_RegL + 1] = {
      0, 0,
      R10_num,
      R10_num,
      R10_num,
      F10_num,
      F10_num,
      R10_num
    };
    static const int hi[Op_RegL + 1] = {
      0, 0,
      OptoReg::Bad,
      OptoReg::Bad,
      R10_H_num,
      OptoReg::Bad,
      F10_H_num,
      R10_H_num
    };
    return OptoRegPair(hi[ideal_reg], lo[ideal_reg]);
  %}
%}

op_attrib op_cost(0);
ins_attrib ins_cost(100);
ins_attrib ins_size(4);
ins_attrib ins_short_branch(0);
ins_attrib ins_alignment(4);

encode %{
%}

pipeline %{
  attributes %{
    variable_size_instructions;
    instruction_unit_size = 2;
    max_instructions_per_bundle = 4;
    instruction_fetch_unit_size = 64;
    instruction_fetch_units = 1;
    nops( MachNop );
  %}

  resources( INS0, INS1 );
  pipe_desc( S0, S1, S2, S3, S4, S5 );

  pipe_class pipe_default() %{
    single_instruction;
  %}
%}

operand iRegI() %{
  constraint(ALLOC_IN_RC(int_reg));
  match(RegI);
  format %{ %}
  interface(REG_INTER);
%}

instruct nopNode() %{
  format %{ "nop" %}
  ins_encode %{
  %}
  ins_pipe(pipe_default);
%}
